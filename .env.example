# Copy to .env and fill in. Local secrets only: never commit or paste into chat. Every value is optional for building the app.
# The Python loader reads literal values; do not source this file in a shell.

# AI chat server (server/): OpenRouter regular API key (not a management key).
PETASOS_OPENROUTER_API_KEY=
# Content pack build (server/tools/build_pack.py): data.go.kr General Authentication Key (Decoding), used for TourAPI and Odii.
PETASOS_DATA_GO_KR_SERVICE_KEY=
# Content pack build: only if the Odii key differs from the data.go.kr key.
PETASOS_ODII_SERVICE_KEY=
# Content pack build: only if the Korean tourism (TourAPI) key differs from the data.go.kr key.
PETASOS_TOURAPI_SERVICE_KEY=
# Region boundary check (optional): VWorld API key; the offline boundary ZIP import does not need it.
PETASOS_VWORLD_API_KEY=
# Region boundary check (optional): the exact service URL registered for that VWorld key; leave blank if unsure.
PETASOS_VWORLD_DOMAIN=
# Not used by the app today (on hold): Kakao Mobility REST key.
PETASOS_KAKAO_MOBILITY_REST_API_KEY=
# Naver Cloud Maps Client ID: server-only Directions 5 lookup (scripts/naver-routes.py); also the Android map key if ANDROID_KEY_ID is blank. Blank = the app uses its built-in map.
PETASOS_NAVER_MAPS_CLIENT_ID=
# Naver Cloud Maps Client Secret: server-only Directions 5 lookup; never goes into the APK.
PETASOS_NAVER_MAPS_CLIENT_SECRET=
# Public Naver map Key ID for the Android app (Dynamic Map, package com.petasos.app); blank reuses CLIENT_ID. Blank both = built-in map.
PETASOS_NAVER_MAPS_ANDROID_KEY_ID=
