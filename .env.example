# Copy to .env. Local secrets only: do not commit or paste into chat.
# The Python loader reads literal values; do not source this file in a shell.

# OpenRouter > API Keys: a regular API key for Petasos (not a management key).
PETASOS_OPENROUTER_API_KEY=

# data.go.kr: General Authentication Key (Decoding), or the original key.
# Used by both already-approved Odii and Korean tourism APIs.
PETASOS_DATA_GO_KR_SERVICE_KEY=

# Optional: only fill if the approved services use different keys.
PETASOS_ODII_SERVICE_KEY=
PETASOS_TOURAPI_SERVICE_KEY=

# Optional VWorld API comparison check: separate from the data.go.kr service key.
# Offline licensed boundary ZIP import does NOT require this key.
# Credentials are never sent to Android or OpenRouter.
PETASOS_VWORLD_API_KEY=
# Optional: the exact service URL registered when issuing this key.
# Leave blank for the initial server-side check; never invent a registered URL.
# This is an authentication value, not a request destination.
PETASOS_VWORLD_DOMAIN=

# Optional research candidate only; registration is ON HOLD, not a P0 prerequisite.
# Keep the existing Pleos-first / Naver auxiliary-route review direction.
# Kakao is not connected to Android; never treat its result as the active Pleos route.
PETASOS_KAKAO_MOBILITY_REST_API_KEY=

# Naver Cloud Maps Directions 5: optional server-only auxiliary route lookup.
# Enable Directions 5 for a Maps application, then enter its Client ID/Secret.
# Keep the Pleos navigation route as the actual navigation state; this is a forecast.
PETASOS_NAVER_MAPS_CLIENT_ID=
PETASOS_NAVER_MAPS_CLIENT_SECRET=

# Optional public Android map Key ID; blank reuses PETASOS_NAVER_MAPS_CLIENT_ID.
# Requires Dynamic Map and Android package com.petasos.app. Never put Client Secret here.
PETASOS_NAVER_MAPS_ANDROID_KEY_ID=
