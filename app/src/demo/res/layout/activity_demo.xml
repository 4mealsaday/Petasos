<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <ScrollView android:id="@+id/preview_content" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/demo_background" android:fillViewport="true" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="@dimen/demo_screen_horizontal" android:paddingVertical="@dimen/demo_screen_vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView style="@style/Widget.Petasos.Demo.Title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:accessibilityHeading="true" android:text="@string/demo_brand" android:textSize="28sp" />
                <TextView style="@style/Widget.Petasos.Demo.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/demo_badge" android:padding="12dp" android:text="@string/demo_badge" android:textColor="@color/demo_accent" />
            </LinearLayout>
            <FrameLayout android:layout_width="match_parent" android:layout_height="330dp" android:layout_marginTop="16dp" android:background="@drawable/demo_panel">
                <FrameLayout android:id="@+id/demo_map_container" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/demo_map_description" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="top" android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
                    <TextView android:id="@+id/demo_region" style="@style/Widget.Petasos.Demo.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/demo_badge" android:padding="12dp" android:text="@string/demo_region_ready" />
                    <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                    <TextView android:id="@+id/demo_clock" style="@style/Widget.Petasos.Demo.Text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/demo_badge" android:padding="12dp" android:fontFeatureSettings="tnum" android:text="@string/demo_clock_initial" />
                </LinearLayout>
                <ImageButton android:id="@+id/playback_talk" android:layout_width="76dp" android:layout_height="76dp" android:layout_gravity="bottom|start" android:layout_margin="20dp" android:background="@drawable/demo_talk_button" android:padding="17dp" android:src="@drawable/ic_petasos" android:contentDescription="@string/demo_talk_description" android:enabled="false" />
                <TextView style="@style/Widget.Petasos.Demo.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|end" android:layout_margin="16dp" android:background="@drawable/demo_badge" android:padding="8dp" android:text="@string/demo_map_caption" />
            </FrameLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/demo_panel" android:gravity="center_vertical" android:orientation="horizontal" android:padding="20dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/playback_status" style="@style/Widget.Petasos.Demo.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ready_title" android:textColor="@color/demo_accent" />
                    <TextView android:id="@+id/demo_story_title" style="@style/Widget.Petasos.Demo.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/demo_story_ready" />
                    <TextView android:id="@+id/demo_caption" style="@style/Widget.Petasos.Demo.Text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:minLines="2" android:textSize="25sp" android:text="@string/demo_caption_ready" />
                    <TextView android:id="@+id/playback_notice" style="@style/Widget.Petasos.Demo.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:accessibilityLiveRegion="polite" android:text="@string/ready_description" />
                </LinearLayout>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="20dp" android:orientation="vertical">
                    <Button android:id="@+id/playback_play" style="@style/Widget.Petasos.Demo.Button.Primary" android:layout_width="124dp" android:layout_height="wrap_content" android:enabled="false" android:text="@string/demo_play" />
                    <Button android:id="@+id/playback_stop" style="@style/Widget.Petasos.Demo.Button.Secondary" android:layout_width="124dp" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:enabled="false" android:text="@string/demo_pause" />
                </LinearLayout>
                <Button android:id="@+id/playback_next" style="@style/Widget.Petasos.Demo.Button.Secondary" android:layout_width="100dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:enabled="false" android:text="@string/demo_skip" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/demo_panel_secondary" android:orientation="vertical" android:padding="20dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView style="@style/Widget.Petasos.Demo.Label" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/demo_controls_title" />
                    <TextView android:id="@+id/demo_seek_label" style="@style/Widget.Petasos.Demo.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFeatureSettings="tnum" android:text="@string/demo_timeline_initial" />
                </LinearLayout>
                <SeekBar android:id="@+id/demo_timeline" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="4dp" android:max="180" android:enabled="false" android:contentDescription="@string/demo_seek_description" android:progressTint="@color/demo_accent" android:thumbTint="@color/demo_accent" />
                <TextView style="@style/Widget.Petasos.Demo.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/demo_seek_note" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="center_vertical" android:baselineAligned="false" android:orientation="horizontal">
                    <Button android:id="@+id/demo_route_anseong" style="@style/Widget.Petasos.Demo.Button.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:enabled="false" android:text="@string/demo_route_anseong" />
                    <Button android:id="@+id/demo_route_yuseong" style="@style/Widget.Petasos.Demo.Button.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:enabled="false" android:text="@string/demo_route_yuseong" />
                    <Button android:id="@+id/demo_route_gap" style="@style/Widget.Petasos.Demo.Button.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:enabled="false" android:text="@string/demo_route_gap" />
                    <Button android:id="@+id/demo_reset" style="@style/Widget.Petasos.Demo.Button.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:enabled="false" android:text="@string/demo_reset" />
                </LinearLayout>
            </LinearLayout>
            <TextView style="@style/Widget.Petasos.Demo.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/demo_scope_note" />
            <!-- Shared renderer hooks for actions deliberately absent from this player. -->
            <View android:id="@+id/story_selection" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <View android:id="@+id/playback_previous" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <View android:id="@+id/playback_new_story" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
    <TextView android:id="@+id/vehicle_policy_notice" style="@style/Widget.Petasos.Demo.Text" android:layout_width="match_parent" android:layout_height="match_parent" android:accessibilityLiveRegion="polite" android:gravity="center" android:paddingHorizontal="@dimen/demo_screen_horizontal" android:paddingVertical="@dimen/demo_screen_vertical" android:text="@string/vehicle_policy_waiting" android:textColor="@color/demo_text_secondary" android:textSize="24sp" android:visibility="visible" />
</merge>
