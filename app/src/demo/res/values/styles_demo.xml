<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Petasos.Demo" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/demo_background</item>
        <item name="android:colorAccent">@color/demo_accent</item>
        <item name="android:statusBarColor">@color/demo_background</item>
        <item name="android:navigationBarColor">@color/demo_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Widget.Petasos.Demo.Text" parent="">
        <item name="android:fontFamily">sans</item>
        <item name="android:textColor">@color/demo_text_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>
    <style name="Widget.Petasos.Demo.Label" parent="Widget.Petasos.Demo.Text">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/demo_text_secondary</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="Widget.Petasos.Demo.Caption" parent="Widget.Petasos.Demo.Text">
        <item name="android:textColor">@color/demo_text_muted</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="Widget.Petasos.Demo.Title" parent="Widget.Petasos.Demo.Text">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/demo_title_size</item>
        <item name="android:lineSpacingExtra">8dp</item>
    </style>
    <style name="Widget.Petasos.Demo.Button" parent="android:style/Widget.Material.Button">
        <item name="android:background">@drawable/demo_button_secondary</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/demo_button_text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">@dimen/demo_control_height</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">10dp</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="Widget.Petasos.Demo.Button.Primary" parent="Widget.Petasos.Demo.Button">
        <item name="android:background">@drawable/demo_button_primary</item>
        <item name="android:textColor">@color/demo_primary_button_text</item>
    </style>
    <style name="Widget.Petasos.Demo.Button.Secondary" parent="Widget.Petasos.Demo.Button">
        <item name="android:minHeight">@dimen/demo_secondary_control_height</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingHorizontal">14dp</item>
    </style>
</resources>
