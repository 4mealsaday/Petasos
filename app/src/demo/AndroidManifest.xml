<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The engine has no UI entry yet. No product/library startup component can execute here. -->
    <uses-permission tools:node="removeAll" />
    <uses-permission-sdk-23 tools:node="removeAll" />
    <permission tools:node="removeAll" />
    <permission-tree tools:node="removeAll" />
    <permission-group tools:node="removeAll" />
    <queries tools:node="removeAll" />
    <application
        tools:node="replace"
        android:name="android.app.Application"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_petasos"
        android:label="Petasos Demo"
        android:supportsRtl="true"
        android:theme="@style/Theme.Petasos"
        android:usesCleartextTraffic="false" />
</manifest>
