<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Petasos" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Bootstrap preview styles; replace these when the product design is decided. -->
    <style name="Widget.Petasos.Preview.Brand" parent="">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">30sp</item>
    </style>

    <style name="Widget.Petasos.Preview.Caption" parent="">
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="Widget.Petasos.Preview.HeroTitle" parent="">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:lineSpacingExtra">@dimen/preview_text_line_spacing</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">40sp</item>
    </style>

    <style name="Widget.Petasos.Preview.HeroDescription" parent="">
        <item name="android:lineSpacingExtra">@dimen/preview_body_line_spacing</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="Widget.Petasos.Preview.Badge" parent="">
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Widget.Petasos.Preview.CardTitle" parent="">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">24sp</item>
    </style>

    <style name="Widget.Petasos.Preview.CardDescription" parent="">
        <item name="android:lineSpacingExtra">@dimen/preview_text_line_spacing</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="Widget.Petasos.Preview.Footer" parent="">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
