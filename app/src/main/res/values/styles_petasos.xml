<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Petasos" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">@font/pretendard_regular</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:textColorPrimary">@color/text_strong</item>
        <item name="android:textColorSecondary">@color/text_sub</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:buttonStyle">@style/Widget.Petasos.Button.Weak</item>
    </style>

    <!-- Type scale (DESIGN.md 2). Hierarchy comes from size and weight, not color. -->
    <style name="Text.Display" parent="">
        <item name="android:fontFamily">@font/pretendard_bold</item>
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:lineHeight">60sp</item>
        <item name="android:textColor">@color/text_strong</item>
    </style>
    <style name="Text.Heading" parent="">
        <item name="android:fontFamily">@font/pretendard_bold</item>
        <item name="android:textSize">@dimen/text_heading</item>
        <item name="android:lineHeight">46sp</item>
        <item name="android:textColor">@color/text_strong</item>
    </style>
    <style name="Text.Title" parent="">
        <item name="android:fontFamily">@font/pretendard_semibold</item>
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:lineHeight">38sp</item>
        <item name="android:textColor">@color/text_strong</item>
    </style>
    <style name="Text.Body" parent="">
        <item name="android:fontFamily">@font/pretendard_regular</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:lineHeight">34sp</item>
        <item name="android:textColor">@color/text</item>
    </style>
    <style name="Text.Label" parent="">
        <item name="android:fontFamily">@font/pretendard_semibold</item>
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:lineHeight">30sp</item>
        <item name="android:textColor">@color/text</item>
    </style>
    <style name="Text.Caption" parent="">
        <item name="android:fontFamily">@font/pretendard_medium</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:lineHeight">26sp</item>
        <item name="android:textColor">@color/text_sub</item>
    </style>

    <!-- Buttons -->
    <style name="Widget.Petasos.Button" parent="">
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@animator/press_scale</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="Widget.Petasos.Button.Primary" parent="Widget.Petasos.Button">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/btn_primary_text</item>
        <item name="android:fontFamily">@font/pretendard_semibold</item>
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:minHeight">@dimen/button_large_height</item>
        <item name="android:paddingHorizontal">@dimen/space_32</item>
    </style>
    <style name="Widget.Petasos.Button.Secondary" parent="Widget.Petasos.Button">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/btn_secondary_text</item>
        <item name="android:fontFamily">@font/pretendard_semibold</item>
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:minHeight">@dimen/button_large_height</item>
        <item name="android:paddingHorizontal">@dimen/space_32</item>
    </style>
    <style name="Widget.Petasos.Button.Weak" parent="Widget.Petasos.Button">
        <item name="android:background">@drawable/bg_button_weak</item>
        <item name="android:textColor">@color/btn_weak_text</item>
        <item name="android:fontFamily">@font/pretendard_semibold</item>
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:minHeight">@dimen/button_weak_height</item>
        <item name="android:paddingHorizontal">@dimen/space_24</item>
    </style>
    <style name="Widget.Petasos.IconButton" parent="">
        <item name="android:layout_width">@dimen/icon_button_size</item>
        <item name="android:layout_height">@dimen/icon_button_size</item>
        <item name="android:background">@drawable/bg_icon_button</item>
        <item name="android:scaleType">center</item>
        <item name="android:stateListAnimator">@animator/press_scale</item>
    </style>

    <!-- Surfaces -->
    <style name="Widget.Petasos.TopBar" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/topbar_height</item>
        <item name="android:background">@drawable/bg_topbar</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingHorizontal">@dimen/space_24</item>
    </style>
    <style name="Widget.Petasos.Card" parent="">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">@dimen/card_padding</item>
    </style>
    <style name="Widget.Petasos.Tab" parent="Text.Label">
        <item name="android:background">@drawable/bg_tab</item>
        <item name="android:textColor">@color/tab_text</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">@dimen/button_weak_height</item>
        <item name="android:paddingHorizontal">@dimen/space_24</item>
    </style>
    <style name="Widget.Petasos.Chip" parent="Text.Label">
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">@dimen/chip_height</item>
        <item name="android:paddingHorizontal">@dimen/space_24</item>
    </style>
    <style name="Widget.Petasos.Row" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/row_height</item>
        <item name="android:background">@drawable/bg_row</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingHorizontal">@dimen/space_32</item>
    </style>
    <style name="Widget.Petasos.Divider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/divider</item>
        <item name="android:background">@color/line</item>
    </style>
</resources>
