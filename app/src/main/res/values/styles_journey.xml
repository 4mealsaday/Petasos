<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.Petasos.Journey.Button" parent="android:style/Widget.Material.Light.Button">
        <item name="android:background">@drawable/bg_glass_surface</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="android:paddingVertical">10dp</item>
    </style>
    <style name="Widget.Petasos.Journey.HomeAction" parent="Widget.Petasos.Journey.Button">
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/glass_text</item>
        <item name="android:textSize">@dimen/journey_home_action_text_size</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:elevation">6dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:padding">24dp</item>
    </style>
    <style name="Widget.Petasos.Journey.Quiet" parent="Widget.Petasos.Journey.Button">
        <item name="android:backgroundTint">@null</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:textSize">@dimen/journey_home_back_text_size</item>
    </style>
    <style name="Widget.Petasos.Journey.Primary" parent="Widget.Petasos.Journey.Button">
        <item name="android:backgroundTint">@color/accent</item>
        <item name="android:textColor">@color/journey_on_blue</item>
    </style>
    <style name="Widget.Petasos.Journey.Title" parent="Widget.Petasos.Preview.CardTitle">
        <item name="android:textSize">28sp</item>
    </style>
    <style name="Widget.Petasos.Journey.Subtitle" parent="Widget.Petasos.Preview.CardDescription">
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
</resources>
