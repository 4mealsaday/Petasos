<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/journey_home_actions"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center">
    <Button android:id="@+id/journey_companion_toggle" style="@style/Widget.Petasos.Journey.HomeAction"
        android:layout_width="0dp" android:layout_height="@dimen/journey_home_action_height" android:layout_weight="1"
        android:layout_margin="8dp" android:drawablePadding="16dp"
        android:text="@string/journey_home_off" />
    <Button android:id="@+id/journey_nav_records" style="@style/Widget.Petasos.Journey.HomeAction"
        android:layout_width="0dp" android:layout_height="@dimen/journey_home_action_height" android:layout_weight="1"
        android:layout_margin="8dp" android:drawablePadding="16dp"
        android:text="@string/journey_home_records" />
</LinearLayout>
