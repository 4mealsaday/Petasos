<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/preview_card_margin_top"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="@dimen/preview_card_padding">

    <TextView style="@style/Widget.Petasos.Preview.CardTitle"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/records_title" />
    <TextView android:id="@+id/records_notice" style="@style/Widget.Petasos.Preview.CardDescription"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/preview_card_description_margin_top"
        android:text="@string/records_description" />
    <Button android:id="@+id/records_location" style="@style/Widget.Petasos.Preview.CardDescription"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="48dp" android:text="@string/records_location_enable" />
    <Button android:id="@+id/records_permission" style="@style/Widget.Petasos.Preview.CardDescription"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="48dp" android:text="@string/records_permission" android:visibility="gone" />
    <TextView style="@style/Widget.Petasos.Preview.CardDescription"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:labelFor="@id/records_keywords" android:text="@string/records_keywords_label" />
    <EditText android:id="@+id/records_keywords" style="@style/Widget.Petasos.Preview.CardDescription"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="48dp" android:inputType="textCapSentences|textMultiLine|textNoSuggestions"
        android:importantForAutofill="no" android:saveEnabled="false"
        android:maxLength="5140" />
    <Button android:id="@+id/records_save_keywords" style="@style/Widget.Petasos.Preview.CardDescription"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="48dp" android:text="@string/records_keywords_save" />
    <Button android:id="@+id/records_refresh" style="@style/Widget.Petasos.Preview.CardDescription"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="48dp" android:text="@string/records_refresh" />
    <Spinner android:id="@+id/records_trip_selection"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="48dp" android:contentDescription="@string/records_trip_selection" />
    <Button android:id="@+id/records_end_trip" style="@style/Widget.Petasos.Preview.CardDescription"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="48dp" android:text="@string/records_end_trip" />
    <TextView android:id="@+id/records_result" style="@style/Widget.Petasos.Preview.CardDescription"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:saveEnabled="false" android:text="@string/records_empty" />
</LinearLayout>
