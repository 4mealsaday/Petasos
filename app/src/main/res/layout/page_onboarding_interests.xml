<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/page_onboarding_interests"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:padding="@dimen/screen_padding" android:visibility="gone">
    <LinearLayout style="@style/Widget.Petasos.Card" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="vertical">
        <TextView style="@style/Text.Heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/interests_heading" />
        <TextView style="@style/Text.Body" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8" android:text="@string/interests_hint" />
        <com.petasos.app.presentation.interests.InterestGridView android:id="@+id/onboarding_interest_grid"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_32" />
        <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        <TextView android:id="@+id/onboarding_notice" style="@style/Text.Caption" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_12" android:visibility="gone" android:saveEnabled="false" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <Button android:id="@+id/onboarding_skip" style="@style/Widget.Petasos.Button.Weak"
                android:layout_width="wrap_content" android:layout_height="@dimen/button_weak_height" android:text="@string/onboarding_skip" />
            <Button android:id="@+id/onboarding_start" style="@style/Widget.Petasos.Button.Primary"
                android:layout_width="0dp" android:layout_height="@dimen/button_large_height" android:layout_weight="1"
                android:layout_marginStart="@dimen/space_16" android:text="@string/onboarding_start" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
