<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <FrameLayout android:id="@+id/preview_content" android:layout_width="match_parent" android:layout_height="match_parent"
        android:visibility="gone" android:background="@drawable/bg_glass_home">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="@dimen/journey_page_padding">
            <Button android:id="@+id/journey_nav_listen" style="@style/Widget.Petasos.Journey.Quiet"
                android:layout_width="128dp" android:layout_height="64dp" android:text="@string/journey_home_back" android:visibility="gone" />
            <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                <ScrollView android:id="@+id/journey_home_page" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
                        android:gravity="center_vertical" android:paddingBottom="96dp">
                        <TextView style="@style/Widget.Petasos.Preview.Brand" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:gravity="center" android:layout_marginBottom="32dp" android:text="@string/app_name" android:textSize="@dimen/journey_home_brand_text_size" />
                        <include layout="@layout/view_home_actions" />
                        <TextView android:id="@+id/journey_home_notice" style="@style/Widget.Petasos.Preview.CardDescription"
                            android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center"
                            android:layout_marginTop="24dp" android:saveEnabled="false" android:visibility="gone" />
                    </LinearLayout>
                </ScrollView>
                <FrameLayout android:id="@+id/journey_records_container" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingBottom="@dimen/journey_records_bottom_inset" android:visibility="gone" />
                <ScrollView android:id="@+id/journey_settings_page" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:visibility="gone">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="96dp">
                        <TextView android:id="@+id/journey_settings_title" style="@style/Widget.Petasos.Journey.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/journey_settings" />
                        <include layout="@layout/view_trip_controls" />
                        <LinearLayout android:id="@+id/journey_playback_settings" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="20dp">
                            <CheckBox android:id="@+id/journey_caption_switch" android:layout_width="match_parent" android:layout_height="64dp" android:text="@string/journey_caption_switch" android:textSize="20sp" />
                            <Button android:id="@+id/journey_playback_options" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/journey_playback_options" />
                            <LinearLayout android:id="@+id/journey_playback_options_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                                <include layout="@layout/view_advanced_playback" />
                            </LinearLayout>
                            <Button android:id="@+id/music_credits" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/music_credits_title" />
                            <TextView style="@style/Widget.Petasos.Preview.CardTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/journey_privacy_heading" />
                            <TextView style="@style/Widget.Petasos.Preview.CardDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/journey_privacy_body" />
                        </LinearLayout>
                    </LinearLayout>
                </ScrollView>
            </FrameLayout>
        </LinearLayout>
        <ImageButton android:id="@+id/journey_nav_settings" android:layout_width="@dimen/journey_settings_button_size" android:layout_height="@dimen/journey_settings_button_size"
            android:layout_gravity="bottom|end" android:layout_margin="20dp" android:background="@drawable/bg_glass_surface"
            android:src="@drawable/ic_journey_settings" android:padding="20dp" android:elevation="6dp"
            android:contentDescription="@string/journey_settings" />
    </FrameLayout>
    <TextView android:id="@+id/vehicle_policy_notice" style="@style/Widget.Petasos.Preview.CardDescription"
        android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:padding="32dp" android:text="@string/vehicle_policy_waiting" />
</merge>
