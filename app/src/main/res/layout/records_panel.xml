<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/records_ui_title" android:textSize="@dimen/journey_records_title_size" android:textStyle="bold" android:textColor="@color/records_ui_text" />
        <Button style="@style/Widget.Petasos.Journey.Button" android:id="@+id/records_ui_refresh" android:layout_width="wrap_content" android:layout_height="@dimen/journey_records_button_height" android:minWidth="128dp" android:text="@string/records_ui_refresh" android:textAllCaps="false" android:textSize="@dimen/journey_records_tab_text_size" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/records_ui_intro" android:textSize="@dimen/journey_records_body_size" android:textColor="@color/records_ui_secondary" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/journey_records_tab_height" android:orientation="horizontal" android:layout_marginBottom="12dp">
        <Button style="@style/Widget.Petasos.Journey.Button" android:id="@+id/records_ui_tab_map" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="@string/records_ui_map" android:textAllCaps="false" android:textSize="@dimen/journey_records_tab_text_size" />
        <Button style="@style/Widget.Petasos.Journey.Button" android:id="@+id/records_ui_tab_album" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="8dp" android:text="@string/records_ui_album" android:textAllCaps="false" android:textSize="@dimen/journey_records_tab_text_size" />
        <Button style="@style/Widget.Petasos.Journey.Button" android:id="@+id/records_ui_tab_trips" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="@string/records_ui_trips" android:textAllCaps="false" android:textSize="@dimen/journey_records_tab_text_size" />
    </LinearLayout>
    <ScrollView android:id="@+id/records_ui_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:id="@+id/records_ui_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="24dp" />
    </ScrollView>
</merge>
