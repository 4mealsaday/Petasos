<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/journey_listen_page"
android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
<Spinner android:id="@+id/story_selection" android:layout_width="match_parent" android:layout_height="64dp" android:contentDescription="@string/story_selection_label" />
<Button android:id="@+id/playback_new_story" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/playback_new_story" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
android:background="@drawable/bg_glass_surface" android:padding="16dp" android:layout_marginTop="12dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="0dp" android:paddingEnd="12dp">
        <TextView android:id="@+id/playback_status" style="@style/Widget.Petasos.Preview.CardTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ready_title" />
        <TextView android:id="@+id/journey_current_title" style="@style/Widget.Petasos.Preview.Footer" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end" />
    </LinearLayout>
    <ImageButton android:id="@+id/playback_talk" android:layout_width="80dp" android:layout_height="80dp" android:background="@drawable/bg_journey_talk"
    android:src="@drawable/ic_petasos" android:padding="12dp" android:scaleType="fitCenter" android:contentDescription="@string/journey_talk_description" />
</LinearLayout>
<TextView android:id="@+id/journey_caption" style="@style/Widget.Petasos.Journey.Subtitle"
android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
android:minLines="2" android:maxLines="4" android:scrollbars="vertical" android:saveEnabled="false" android:text="@string/journey_caption_idle" />
<com.petasos.app.presentation.CompanionActionGrid android:id="@+id/journey_playback_actions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp">
    <Button android:id="@+id/playback_previous" android:layout_width="wrap_content" android:layout_height="64dp" android:minWidth="0dp" android:paddingHorizontal="8dp" android:text="@string/playback_previous" />
    <Button android:id="@+id/playback_play" style="@style/Widget.Petasos.Journey.Primary" android:layout_width="wrap_content" android:layout_height="64dp" android:minWidth="0dp" android:paddingHorizontal="8dp" android:text="@string/playback_play" />
    <Button android:id="@+id/playback_stop" android:layout_width="wrap_content" android:layout_height="64dp" android:minWidth="0dp" android:paddingHorizontal="8dp" android:text="@string/journey_pause" />
    <Button android:id="@+id/playback_next" android:layout_width="wrap_content" android:layout_height="64dp" android:minWidth="0dp" android:paddingHorizontal="8dp" android:text="@string/playback_next" />
</com.petasos.app.presentation.CompanionActionGrid>
<TextView android:id="@+id/playback_notice" style="@style/Widget.Petasos.Preview.Footer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/ready_description" />
</LinearLayout>
<com.petasos.app.presentation.CompanionActionGrid android:id="@+id/journey_navigation_actions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
<Button android:id="@+id/journey_open_navigation" android:layout_width="wrap_content" android:layout_height="64dp" android:minWidth="0dp" android:paddingHorizontal="8dp" android:text="@string/journey_open_navigation" />
<Button android:id="@+id/journey_search_destination" android:layout_width="wrap_content" android:layout_height="64dp" android:minWidth="0dp" android:paddingHorizontal="8dp" android:text="@string/journey_search_destination" />
<Button android:id="@+id/journey_show_route" android:layout_width="wrap_content" android:layout_height="64dp" android:minWidth="0dp" android:paddingHorizontal="8dp" android:text="@string/journey_show_route" />
</com.petasos.app.presentation.CompanionActionGrid>
<TextView android:id="@+id/journey_navigation_notice" style="@style/Widget.Petasos.Preview.Footer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/journey_navigation_hint" />
</LinearLayout>
