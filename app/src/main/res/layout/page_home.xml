<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/page_home"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <LinearLayout style="@style/Widget.Petasos.TopBar">
        <FrameLayout android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/bg_logo_tile">
            <ImageView android:layout_width="44dp" android:layout_height="44dp" android:layout_gravity="center"
                android:src="@drawable/ic_petasos_mark" android:importantForAccessibility="no" />
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="@dimen/space_16" android:orientation="vertical">
            <TextView style="@style/Text.Heading" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/app_name" android:includeFontPadding="false" />
            <TextView style="@style/Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/app_tagline" android:includeFontPadding="false" />
        </LinearLayout>
        <ImageButton android:id="@+id/home_settings" style="@style/Widget.Petasos.IconButton"
            android:src="@drawable/ic_settings" android:contentDescription="@string/action_settings" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:padding="@dimen/screen_padding">
        <LinearLayout android:id="@+id/home_companion_card" style="@style/Widget.Petasos.Card"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="2" android:orientation="vertical">
            <!-- OFF: title, three steps, readiness -->
            <LinearLayout android:id="@+id/home_off_group" android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1" android:orientation="vertical">
                <TextView style="@style/Text.Heading" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/home_off_message" />
                <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="@dimen/space_24" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <FrameLayout android:layout_width="64dp" android:layout_height="64dp" android:background="@drawable/bg_icon_tile_soft">
                        <ImageView android:layout_width="@dimen/icon_size" android:layout_height="@dimen/icon_size" android:layout_gravity="center"
                            android:src="@drawable/ic_play_arrow" android:tint="@color/primary" android:importantForAccessibility="no" />
                    </FrameLayout>
                    <TextView android:id="@+id/home_step_1" style="@style/Text.Body" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="@dimen/space_16" android:text="@string/home_step_1" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginStart="@dimen/space_16">
                    <FrameLayout android:layout_width="64dp" android:layout_height="64dp" android:background="@drawable/bg_icon_tile_soft">
                        <ImageView android:layout_width="@dimen/icon_size" android:layout_height="@dimen/icon_size" android:layout_gravity="center"
                            android:src="@drawable/ic_menu_book" android:tint="@color/primary" android:importantForAccessibility="no" />
                    </FrameLayout>
                    <TextView android:id="@+id/home_step_2" style="@style/Text.Body" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="@dimen/space_16" android:text="@string/home_step_2" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginStart="@dimen/space_16">
                    <FrameLayout android:layout_width="64dp" android:layout_height="64dp" android:background="@drawable/bg_icon_tile_soft">
                        <ImageView android:layout_width="@dimen/icon_size" android:layout_height="@dimen/icon_size" android:layout_gravity="center"
                            android:src="@drawable/ic_mic" android:tint="@color/primary" android:importantForAccessibility="no" />
                    </FrameLayout>
                    <TextView android:id="@+id/home_step_3" style="@style/Text.Body" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="@dimen/space_16" android:text="@string/home_step_3" />
                </LinearLayout>
                </LinearLayout>
                <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="@dimen/space_24" />
                <View style="@style/Widget.Petasos.Divider" />
                <TextView style="@style/Text.Label" android:textColor="@color/text_sub" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_16" android:layout_marginBottom="@dimen/space_4"
                    android:text="@string/home_ready_title" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center_vertical">
                    <ImageView android:layout_width="@dimen/icon_size" android:layout_height="@dimen/icon_size" android:src="@drawable/ic_location_on"
                        android:importantForAccessibility="no" />
                    <TextView style="@style/Text.Title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:layout_marginStart="@dimen/space_16" android:text="@string/home_ready_location" />
                    <TextView android:id="@+id/home_ready_location_state" style="@style/Text.Label" android:layout_width="wrap_content"
                        android:layout_height="52dp" android:gravity="center" android:paddingHorizontal="@dimen/space_24"
                        android:drawablePadding="@dimen/space_8" android:background="@drawable/bg_ready_pill" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center_vertical">
                    <ImageView android:layout_width="@dimen/icon_size" android:layout_height="@dimen/icon_size" android:src="@drawable/ic_mic"
                        android:importantForAccessibility="no" />
                    <TextView style="@style/Text.Title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:layout_marginStart="@dimen/space_16" android:text="@string/home_ready_mic" />
                    <TextView android:id="@+id/home_ready_mic_state" style="@style/Text.Label" android:layout_width="wrap_content"
                        android:layout_height="52dp" android:gravity="center" android:paddingHorizontal="@dimen/space_24"
                        android:drawablePadding="@dimen/space_8" android:background="@drawable/bg_ready_pill" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center_vertical">
                    <ImageView android:layout_width="@dimen/icon_size" android:layout_height="@dimen/icon_size" android:src="@drawable/ic_layers"
                        android:importantForAccessibility="no" />
                    <TextView style="@style/Text.Title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:layout_marginStart="@dimen/space_16" android:text="@string/home_ready_overlay" />
                    <TextView android:id="@+id/home_ready_overlay_state" style="@style/Text.Label" android:layout_width="wrap_content"
                        android:layout_height="52dp" android:gravity="center" android:paddingHorizontal="@dimen/space_24"
                        android:drawablePadding="@dimen/space_8" android:background="@drawable/bg_ready_pill" />
                </LinearLayout>
                <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="@dimen/space_16" />
            </LinearLayout>
            <!-- ON: current region and what is playing -->
            <LinearLayout android:id="@+id/home_on_group" android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1" android:orientation="vertical" android:visibility="gone">
                <TextView android:id="@+id/home_on_label" style="@style/Text.Label" android:textColor="@color/primary"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_on_title" />
                <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
                <TextView android:id="@+id/home_on_region" style="@style/Text.Display" android:textSize="72sp" android:lineHeight="88sp"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/home_on_waiting" style="@style/Text.Heading" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="@string/home_on_waiting" />
                <LinearLayout android:id="@+id/home_on_now" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_24" android:gravity="center_vertical">
                    <FrameLayout android:layout_width="64dp" android:layout_height="64dp" android:background="@drawable/bg_icon_tile_soft">
                        <ImageView android:id="@+id/home_on_now_icon" android:layout_width="@dimen/icon_size" android:layout_height="@dimen/icon_size"
                            android:layout_gravity="center" android:src="@drawable/ic_menu_book" android:tint="@color/primary"
                            android:importantForAccessibility="no" />
                    </FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:layout_marginStart="@dimen/space_16" android:orientation="vertical">
                        <TextView android:id="@+id/home_on_now_kind" style="@style/Text.Caption" android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                        <TextView android:id="@+id/home_on_now_title" style="@style/Text.Title" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end" />
                    </LinearLayout>
                </LinearLayout>
                <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
            </LinearLayout>
            <TextView android:id="@+id/home_notice" style="@style/Text.Caption" android:textColor="@color/negative"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/space_16"
                android:visibility="gone" android:saveEnabled="false" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
                android:gravity="center_vertical">
                <Button android:id="@+id/home_primary" style="@style/Widget.Petasos.Button.Primary"
                    android:layout_width="0dp" android:layout_height="@dimen/button_large_height" android:layout_weight="1"
                    android:text="@string/home_start" />
                <Button android:id="@+id/home_stop" style="@style/Widget.Petasos.Button.Weak"
                    android:layout_width="wrap_content" android:layout_height="@dimen/button_weak_height"
                    android:layout_marginStart="@dimen/space_16" android:text="@string/home_stop" android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/home_trips_card" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_marginStart="@dimen/card_gap" android:orientation="vertical"
            android:padding="@dimen/card_padding" android:background="@drawable/bg_card_pressable" android:clickable="true" android:focusable="true"
            android:stateListAnimator="@animator/press_scale">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <TextView style="@style/Text.Title" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="@string/home_trips_title" />
                <ImageView android:layout_width="@dimen/icon_size" android:layout_height="@dimen/icon_size"
                    android:src="@drawable/ic_chevron_right" android:importantForAccessibility="no" />
            </LinearLayout>
            <FrameLayout android:id="@+id/home_trips_map_frame" android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1" android:layout_marginVertical="@dimen/space_24">
                <com.petasos.app.presentation.records.RegionalMapView android:id="@+id/home_trips_map"
                    android:layout_width="match_parent" android:layout_height="match_parent" android:minHeight="0dp"
                    android:clickable="false" android:focusable="false" android:importantForAccessibility="no" android:visibility="gone" />
            </FrameLayout>
            <TextView android:id="@+id/home_trips_summary" style="@style/Text.Body"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_trips_empty" />
            <TextView android:id="@+id/home_trips_latest" style="@style/Text.Caption"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
