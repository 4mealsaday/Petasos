<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/overlay_card_height"
    android:background="@drawable/bg_overlay_card"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="@dimen/overlay_card_padding_horizontal"
    android:paddingEnd="@dimen/overlay_card_padding_horizontal">

    <TextView
        android:id="@+id/overlay_card_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/glass_text"
        android:textSize="@dimen/overlay_card_text_size"
        android:maxLines="2"
        android:ellipsize="end" />
</LinearLayout>
