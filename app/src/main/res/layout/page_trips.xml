<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/page_trips"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone">
    <LinearLayout style="@style/Widget.Petasos.TopBar">
        <ImageButton android:id="@+id/trips_back" style="@style/Widget.Petasos.IconButton"
            android:src="@drawable/ic_arrow_back" android:contentDescription="@string/action_back" />
        <TextView style="@style/Text.Heading" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="@dimen/space_8" android:text="@string/trips_title" />
        <ImageButton android:id="@+id/trips_settings" style="@style/Widget.Petasos.IconButton"
            android:src="@drawable/ic_settings" android:contentDescription="@string/action_settings" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:padding="@dimen/screen_padding">
        <FrameLayout android:id="@+id/trips_map_frame" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="3">
            <TextView android:id="@+id/trips_map_attribution" style="@style/Text.Caption"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|start"
                android:layout_margin="@dimen/space_12" android:paddingHorizontal="@dimen/space_12" android:paddingVertical="@dimen/space_4"
                android:background="@drawable/bg_attribution" android:text="@string/trips_map_attribution" />
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="2"
            android:layout_marginStart="@dimen/card_gap" android:orientation="vertical" android:background="@drawable/bg_card">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_16" android:paddingTop="@dimen/space_8">
                <TextView android:id="@+id/trips_tab_regions" style="@style/Widget.Petasos.Tab"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="@string/trips_tab_regions" />
                <TextView android:id="@+id/trips_tab_journeys" style="@style/Widget.Petasos.Tab"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="@string/trips_tab_journeys" />
            </LinearLayout>
            <View style="@style/Widget.Petasos.Divider" />
            <ScrollView android:id="@+id/trips_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                <LinearLayout android:id="@+id/trips_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
